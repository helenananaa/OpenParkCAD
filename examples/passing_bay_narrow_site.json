{
  "version": "0.3",
  "name": "narrow two-way with synthesized passing bays",
  "units": "m",
  "standards": {
    "jurisdiction": "CN",
    "standard_profile": "custom",
    "strictness": "conservative",
    "notes": "Single-vehicle two-way aisle unlocked by enable_passing_bay_synthesis; side pockets feed Phase 5Q."
  },
  "site": {
    "boundary": {
      "type": "polygon",
      "points": [[0, 0], [20, 0], [20, 80], [0, 80]]
