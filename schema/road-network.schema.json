{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openparkcad.local/schema/road-network.schema.json",
  "title": "optimization.road_network (v0.5 runtime)",
  "description": "Live runtime field consumed by generate_layout. Booleans are not integers; budgets must be finite positives. The user-owned openparkcad-input.schema.json is not modified this round; illegal values fail-closed at runtime.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": { "type": "boolean" },
    "families": {
      "type": "array",
      "items": { "type": "string", "enum": ["legacy", "parallel_ladder"] },
      "minItems": 1
    },
    "max_skeletons": { "type": "integer", "minimum": 1 },
    "dominant_axis_count": { "type": "integer", "minimum": 1 },
    "max_parallel_aisles": { "type": "integer", "minimum": 1 },
    "max_full_evaluations": { "type": "integer", "minimum": 1 },
    "refinement_budget_seconds": { "type": "number", "exclusiveMinimum": 0 },
    "cross_aisle_policy": { "type": "string", "enum": ["entry_end", "both_ends"] },
    "allow_one_way_loop": { "type": "boolean" }
  }
}
