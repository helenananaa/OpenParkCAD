{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openparkcad.local/schema/road-network.schema.json",
  "title": "optimization.road_network (v0.5 runtime)",
  "description": "Explicit opt-in road-network search. Omitted fields use runtime defaults; null, unknown fields and unsupported loops are rejected.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "families": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "legacy",
          "parallel_ladder"
        ]
      },
      "minItems": 1,
      "default": [
        "legacy"
      ]
    },
    "max_skeletons": {
      "type": "integer",
      "minimum": 1,
      "default": 16
    },
    "dominant_axis_count": {
      "type": "integer",
      "minimum": 1,
      "default": 2
    },
    "max_parallel_aisles": {
      "type": "integer",
      "minimum": 1,
      "default": 6
    },
    "max_full_evaluations": {
      "type": "integer",
      "minimum": 1,
      "default": 8
    },
    "refinement_budget_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "cross_aisle_policy": {
      "type": "string",
      "enum": [
        "entry_end",
        "both_ends"
      ],
      "default": "entry_end"
    },
    "allow_one_way_loop": {
      "type": "boolean",
      "const": false,
      "default": false
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "description": "Opt-in fixed-skeleton occupied-stall conflict repair; requires road traversal. Never changes stall dimensions or vehicle constraints.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "max_rounds": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "time_budget_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 30
        },
        "min_retained_stalls": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      }
    },
    "spacing_search": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "inter_aisle_gaps_m": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "stall_gaps_m": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "max_variants": {
          "type": "integer",
          "minimum": 1,
          "default": 4
        },
        "stop_after_improvement": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
