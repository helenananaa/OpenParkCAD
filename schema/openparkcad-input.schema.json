{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/helenananaa/OpenParkCAD/blob/main/schema/openparkcad-input.schema.json",
  "title": "OpenParkCAD input",
  "description": "Machine-readable shape for OpenParkCAD inputs. Schema acceptance does not imply that every declared rule is enforced; inspect report support status.",
  "type": "object",
  "required": ["version", "site", "entrances", "parking", "aisles"],
  "properties": {
    "$schema": {"type": "string", "format": "uri-reference"},
    "version": {"type": "string", "enum": ["0.1", "0.2", "0.3"]},
    "name": {"type": "string", "minLength": 1},
    "units": {"type": "string", "enum": ["m"]},
    "standards": {
      "type": "object",
      "properties": {
        "jurisdiction": {"type": "string"},
        "standard_profile": {"type": "string"},
        "rule_profile": {"type": "string"},
        "strictness": {"type": "string"},
        "source": {"type": "string"},
        "effective_date": {"type": "string", "format": "date"}
      },
      "additionalProperties": true
    },
    "site": {
      "type": "object",
      "required": ["boundary"],
      "properties": {
        "boundary": {"$ref": "#/$defs/polygonGeometry"},
        "obstacles": {
          "type": "array",
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/polygonPoints"},
              {"$ref": "#/$defs/scopedGeometryObject"}
            ]
          },
          "default": []
        },
        "reserved_areas": {
          "type": "array",
          "items": {"$ref": "#/$defs/scopedGeometryObject"},
          "default": []
        }
      },
      "additionalProperties": true
    },
    "site_features": {
      "type": "array",
      "items": {"$ref": "#/$defs/scopedGeometryObject"},
      "default": []
    },
    "entrances": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entrance"}
    },
    "pedestrian_and_emergency": {
      "type": "object",
      "properties": {
        "pedestrian_routes": {
          "type": "array",
          "items": {"$ref": "#/$defs/scopedGeometryObject"}
        },
        "accessible_routes": {
          "type": "array",
          "items": {"$ref": "#/$defs/scopedGeometryObject"}
        },
        "fire_lanes": {
          "type": "array",
          "items": {"$ref": "#/$defs/scopedGeometryObject"}
        },
        "emergency_access_required": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "vehicles": {
      "type": "object",
      "properties": {
        "design_vehicle": {"$ref": "#/$defs/vehicle"}
      },
      "additionalProperties": true
    },
    "parking": {
      "type": "object",
      "required": ["stall_types"],
      "properties": {
        "stall_types": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/stallType"}
        },
        "quotas": {
          "type": "object",
          "properties": {
            "accessible_min": {"type": "integer", "minimum": 0},
            "ev_min": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "aisles": {
      "type": "object",
      "required": ["classes"],
      "properties": {
        "selection_mode": {
          "type": "string",
          "enum": ["fixed", "allowed", "solver_choice"]
        },
        "fixed_class": {"type": "string"},
        "classes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/aisleClass"}
        }
      },
      "additionalProperties": true
    },
    "constraints": {
      "type": "object",
      "properties": {
        "authority": {
          "type": "string",
          "enum": ["advisory", "project_policy", "jurisdictional"]
        },
        "setbacks": {
          "type": "object",
          "properties": {
            "site_boundary": {"type": "number", "minimum": 0},
            "obstacle": {"type": "number", "minimum": 0}
          },
          "additionalProperties": true
        },
        "circulation": {"type": "object", "additionalProperties": true},
        "maneuvering": {
          "type": "object",
          "properties": {
            "require_turning_radius_check": {"type": "boolean"},
            "require_swept_path_check": {"type": "boolean"},
            "max_reverse_distance": {"type": "number", "exclusiveMinimum": 0}
          },
          "additionalProperties": true
        },
        "road_traversal": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "scope": {"type": "string", "enum": ["site_interior"]},
            "time_budget_seconds": {"type": "number", "exclusiveMinimum": 0, "default": 10.0}
          },
          "additionalProperties": false
        },
        "accessible_route_touch_tolerance": {"type": "number", "minimum": 0},
        "emergency_route_touch_tolerance": {"type": "number", "minimum": 0},
        "ev_charger_touch_tolerance": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    },
    "optimization": {
      "type": "object",
      "properties": {
        "road_network": {"$ref": "#/$defs/roadNetwork"},
        "selector_num_workers": {
          "type": "integer",
          "minimum": 1,
          "description": "Optional CP-SAT search worker count. Omitted keeps the OR-Tools default."
        },
        "layout_search": {
          "type": "object",
          "properties": {
            "mode": {"type": "string", "enum": ["legacy", "multi_spine"], "default": "legacy"},
            "top_k": {"type": "integer", "minimum": 1, "default": 4},
            "refinement_budget_seconds": {"type": "number", "exclusiveMinimum": 0, "default": 10.0}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "diagnostics": {"type": "object", "additionalProperties": true},
    "metadata": {"type": "object", "additionalProperties": true},
    "regression_expectations": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": true,
  "$defs": {
    "roadNetwork": {
      "description": "Explicit opt-in road-network search. Omitted fields use runtime defaults; null, unknown fields and unsupported loops are rejected.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "families": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "legacy",
              "parallel_ladder"
            ]
          },
          "minItems": 1,
          "default": [
            "legacy"
          ]
        },
        "max_skeletons": {
          "type": "integer",
          "minimum": 1,
          "default": 16
        },
        "dominant_axis_count": {
          "type": "integer",
          "minimum": 1,
          "default": 2
        },
        "max_parallel_aisles": {
          "type": "integer",
          "minimum": 1,
          "default": 6
        },
        "max_full_evaluations": {
          "type": "integer",
          "minimum": 1,
          "default": 8
        },
        "refinement_budget_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cross_aisle_policy": {
          "type": "string",
          "enum": [
            "entry_end",
            "both_ends"
          ],
          "default": "entry_end"
        },
        "allow_one_way_loop": {
          "type": "boolean",
          "const": false,
          "default": false
        },
        "repair": {
          "type": "object",
          "additionalProperties": false,
          "description": "Opt-in fixed-skeleton occupied-stall conflict repair; requires road traversal. Never changes stall dimensions or vehicle constraints.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "max_rounds": {
              "type": "integer",
              "minimum": 1,
              "default": 3
            },
            "time_budget_seconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 30
            },
            "min_retained_stalls": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          }
        },
        "spacing_search": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "inter_aisle_gaps_m": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "number",
                "minimum": 0
              }
            },
            "stall_gaps_m": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "number",
                "minimum": 0
              }
            },
            "max_variants": {
              "type": "integer",
              "minimum": 1,
              "default": 4
            },
            "stop_after_improvement": {
              "type": "boolean",
              "default": true
            }
          }
        }
      }
    },
    "point": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "polygonPoints": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/point"}
    },
    "polygonGeometry": {
      "type": "object",
      "required": ["type", "points"],
      "properties": {
        "type": {"const": "polygon"},
        "points": {"$ref": "#/$defs/polygonPoints"}
      },
      "additionalProperties": true
    },
    "circleGeometry": {
      "type": "object",
      "required": ["type", "center", "radius"],
      "properties": {
        "type": {"const": "circle"},
        "center": {"$ref": "#/$defs/point"},
        "radius": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": true
    },
    "rectangleGeometry": {
      "type": "object",
      "required": ["type", "origin", "width", "height"],
      "properties": {
        "type": {"const": "rectangle"},
        "origin": {"$ref": "#/$defs/point"},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0},
        "rotation_degrees": {"type": "number"}
      },
      "additionalProperties": true
    },
    "polylineBufferGeometry": {
      "type": "object",
      "required": ["type", "points", "width"],
      "properties": {
        "type": {"const": "polyline_buffer"},
        "points": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/point"}
        },
        "width": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": true
    },
    "geometry": {
      "oneOf": [
        {"$ref": "#/$defs/polygonGeometry"},
        {"$ref": "#/$defs/circleGeometry"},
        {"$ref": "#/$defs/rectangleGeometry"},
        {"$ref": "#/$defs/polylineBufferGeometry"}
      ]
    },
    "scopedGeometryObject": {
      "type": "object",
      "required": ["id", "geometry"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string"},
        "geometry": {"$ref": "#/$defs/geometry"},
        "clearance": {"type": "number", "minimum": 0},
        "parking_allowed": {"type": "boolean"},
        "vehicle_allowed": {"type": "boolean"},
        "affects": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "authority": {
          "type": "string",
          "enum": ["advisory", "project_policy", "jurisdictional"]
        },
        "priority": {
          "type": "string",
          "enum": ["hard", "advisory", "soft", "draw_only", "future"]
        },
        "connects": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "min_width": {"type": "number", "exclusiveMinimum": 0},
        "max_slope": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    },
    "entrance": {
      "type": "object",
      "required": ["id", "center", "width", "heading_degrees"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "mode": {"type": "string", "enum": ["shared", "entry_only", "exit_only"]},
        "center": {"$ref": "#/$defs/point"},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "heading_degrees": {"type": "number"},
        "allowed_movements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["enter", "exit"]}
        }
      },
      "additionalProperties": true
    },
    "vehicle": {
      "type": "object",
      "required": ["id", "length", "width"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "length": {"type": "number", "exclusiveMinimum": 0},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "wheelbase": {"type": "number", "exclusiveMinimum": 0},
        "min_turning_radius": {"type": "number", "exclusiveMinimum": 0},
        "turning_radius_reference": {
          "type": "string",
          "enum": ["outer_front_wheel", "rear_axle_center"]
        },
        "track_width": {"type": "number", "exclusiveMinimum": 0},
        "front_overhang": {"type": "number", "minimum": 0},
        "rear_overhang": {"type": "number", "minimum": 0},
        "swept_path_margin": {"type": "number", "minimum": 0},
        "max_reverse_distance": {"type": "number", "exclusiveMinimum": 0},
        "configuration": {"type": "string", "enum": ["rigid", "articulated"]},
        "hitch_offset": {"type": "number"},
        "trailer": {"$ref": "#/$defs/trailer"}
      },
      "additionalProperties": true
    },
    "trailer": {
      "type": "object",
      "required": ["length", "width"],
      "properties": {
        "length": {"type": "number", "exclusiveMinimum": 0},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "wheelbase": {"type": "number", "exclusiveMinimum": 0},
        "track_width": {"type": "number", "exclusiveMinimum": 0},
        "front_overhang": {"type": "number", "minimum": 0},
        "rear_overhang": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    },
    "stallType": {
      "type": "object",
      "required": ["id", "family", "width", "length"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "family": {
          "type": "string",
          "enum": ["perpendicular", "angled", "parallel", "t_end", "painted"]
        },
        "width": {"type": "number", "exclusiveMinimum": 0},
        "length": {"type": "number", "exclusiveMinimum": 0},
        "allowed_angles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "number", "minimum": 0, "maximum": 180}
        },
        "drive_over": {"type": "boolean"},
        "access_sides": {"type": "array", "items": {"type": "string"}},
        "blocked_sides": {"type": "array", "items": {"type": "string"}},
        "classifications": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["accessible", "ev"]}
        },
        "tags": {
          "description": "Compatibility alias for classifications.",
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "qualifications": {
          "description": "Accepted legacy vocabulary; classifications is the canonical v0.3 field.",
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "enabled": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "aisleClass": {
      "type": "object",
      "required": ["id", "width"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "capacity": {"type": "string"},
        "directionality": {"type": "string", "enum": ["one_way", "two_way"]},
        "centerline_crossing": {"type": "string", "enum": ["allowed", "forbidden", "not_applicable"]},
        "enabled": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  }
}
